# Shakedown configuration. Copy to .env and edit; never commit .env.
# Any OpenAI-compatible endpoint works. Defaults target a local Ollama server.
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5:7b-instruct-q4_K_M
MODEL_API_KEY=local
# Optional remote pricing for spend estimates (USD per 1M tokens).
# Local Ollama is free; set these if you point at a paid endpoint.
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0
# For a genuinely free remote endpoint, explicitly set MODEL_API_FREE=true.
MODEL_API_FREE=false
# Hard caps (enforced by the proxy, not just advisory).
MAX_USD=15
MAX_TOTAL_CALLS=6000