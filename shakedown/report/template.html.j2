<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Shakedown · {{ a.experiment_id }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f4f6f2; --surface: #fff; --surface-2: #f0f3ee; --ink: #152019;
      --muted: #68756c; --line: #dfe6df; --accent: #256d4c; --accent-soft: #e0f1e7;
      --critical: #b33d3d; --critical-soft: #fbe8e5; --helpful: #18735d;
      --helpful-soft: #dcf2e9; --warning: #9a681a; --warning-soft: #fbf0d6;
      --shadow: 0 16px 45px rgba(18, 44, 30, .07);
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #0b1110; --surface: #121b18; --surface-2: #192520; --ink: #edf4ee;
      --muted: #a0aea4; --line: #293a31; --accent: #87d7a7; --accent-soft: #1d3a2b;
      --critical: #ff938b; --critical-soft: #442522; --helpful: #8ed9b6;
      --helpful-soft: #1d3a2f; --warning: #f0c777; --warning-soft: #40351f;
      --shadow: 0 16px 45px rgba(0, 0, 0, .22);
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg: #0b1110; --surface: #121b18; --surface-2: #192520; --ink: #edf4ee;
        --muted: #a0aea4; --line: #293a31; --accent: #87d7a7; --accent-soft: #1d3a2b;
        --critical: #ff938b; --critical-soft: #442522; --helpful: #8ed9b6;
        --helpful-soft: #1d3a2f; --warning: #f0c777; --warning-soft: #40351f;
        --shadow: 0 16px 45px rgba(0, 0, 0, .22);
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background:
        radial-gradient(ellipse at 12% 0%, rgba(76, 155, 107, .11), transparent 34rem),
        var(--bg); color: var(--ink);
      font: 14px/1.55 Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    .shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; padding: 30px 0 70px; }
    .topbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
    .brand { display: flex; align-items: center; gap: 12px; font-weight: 750; letter-spacing: -.03em; }
    .mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px;
      background: var(--accent); color: #fff; font-size: 19px; }
    .brand small { display: block; color: var(--muted); font-size: 11px; font-weight: 550;
      letter-spacing: .08em; text-transform: uppercase; }
    .top-actions { display: flex; align-items: center; gap: 10px; }
    .run-id, .pill { border: 1px solid var(--line); border-radius: 999px; color: var(--muted);
      padding: 6px 11px; font-size: 11px; }
    button { border: 1px solid var(--line); border-radius: 10px; padding: 8px 11px;
      background: var(--surface); color: var(--ink); cursor: pointer; font: inherit; font-size: 12px; }
    .hero { display: grid; grid-template-columns: 1.25fr .75fr; gap: 18px; margin-top: 32px; }
    .panel { border: 1px solid var(--line); background: var(--surface); border-radius: 18px;
      box-shadow: var(--shadow); }
    .hero-main { padding: 30px; position: relative; overflow: hidden; }
    .hero-main:after { content: ""; position: absolute; right: -55px; top: -85px; width: 250px;
      height: 250px; border: 1px solid var(--line); border-radius: 50%;
      box-shadow: 0 0 0 28px var(--surface), 0 0 0 29px var(--line),
                  0 0 0 58px var(--surface), 0 0 0 59px var(--line); opacity: .55; }
    .eyebrow { color: var(--accent); text-transform: uppercase; letter-spacing: .13em;
      font-size: 10px; font-weight: 800; }
    h1 { margin: 10px 0 8px; font-size: clamp(32px, 5vw, 52px); line-height: 1.02;
      letter-spacing: -.055em; max-width: 620px; }
    .lead { color: var(--muted); max-width: 570px; margin: 0; }
    .baseline-row { display: flex; align-items: end; gap: 18px; margin-top: 28px; position: relative; z-index: 1; }
    .baseline-value { font-size: clamp(46px, 7vw, 72px); font-weight: 780; letter-spacing: -.07em;
      line-height: .9; color: var(--accent); }
    .baseline-meta { padding-bottom: 4px; color: var(--muted); }
    .baseline-meta strong { display: block; color: var(--ink); font-size: 14px; }
    .hero-side { display: flex; flex-direction: column; gap: 12px; padding: 18px; }
    .mini-stat { display: flex; justify-content: space-between; align-items: center;
      padding: 13px 14px; border-radius: 12px; background: var(--surface-2); }
    .mini-stat span { color: var(--muted); font-size: 12px; }
    .mini-stat strong { font-size: 16px; font-variant-numeric: tabular-nums; }
    .model-note { margin-top: auto; padding: 8px 4px 0; color: var(--muted); font-size: 11px; }
    section { margin-top: 34px; }
    .section-head { display: flex; justify-content: space-between; align-items: end; gap: 16px;
      margin: 0 0 13px; }
    h2 { margin: 0; font-size: 20px; letter-spacing: -.035em; }
    .section-head p { margin: 2px 0 0; color: var(--muted); font-size: 12px; }
    .legend { display: flex; flex-wrap: wrap; gap: 10px; color: var(--muted); font-size: 10px; }
    .legend span:before { content: ""; display: inline-block; width: 7px; height: 7px;
      border-radius: 50%; background: currentColor; margin-right: 5px; }
    .legend .lg-critical { color: var(--critical); } .legend .lg-clear { color: var(--helpful); }
    .legend .lg-open { color: var(--warning); }
    .heatmap { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 11px; }
    .heat-cell { min-width: 0; border: 1px solid var(--line); background: var(--surface);
      border-radius: 14px; padding: 14px; position: relative; overflow: hidden; }
    .heat-cell:before { content: ""; position: absolute; inset: auto 0 0; height: 3px;
      background: var(--meter-color, var(--warning)); }
    .heat-cell.critical { --meter-color: var(--critical); }
    .heat-cell.helpful { --meter-color: var(--helpful); }
    .heat-cell.dead-weight { --meter-color: var(--accent); }
    .heat-cell.inconclusive, .heat-cell.not-run { --meter-color: var(--warning); }
    .cell-top { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
    .kind { color: var(--muted); font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
    .verdict { color: var(--meter-color); font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .cell-title { font-size: 13px; font-weight: 700; margin: 8px 0 9px; min-height: 38px; }
    .rate-line { display: flex; justify-content: space-between; color: var(--muted); font-size: 10px; }
    .track { height: 6px; background: var(--surface-2); border-radius: 99px; overflow: hidden; margin: 6px 0 9px; }
    .fill { height: 100%; background: var(--meter-color); border-radius: inherit; }
    .cell-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;
      border-top: 1px solid var(--line); padding-top: 9px; }
    .cell-metrics span { color: var(--muted); font-size: 9px; display: block; }
    .cell-metrics strong { display: block; font-size: 11px; font-variant-numeric: tabular-nums; }
    .cell-note { margin: 10px 0 0; color: var(--muted); font-size: 10px; }
    .empty { padding: 30px; text-align: center; color: var(--muted); grid-column: 1 / -1; }
    .lower-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .content-card { padding: 19px; }
    .timeline { display: flex; gap: 0; overflow-x: auto; padding: 16px 0 4px; }
    .timeline-step { min-width: 150px; flex: 1; position: relative; padding: 0 12px 0 0; }
    .timeline-step:before { content: ""; position: absolute; top: 9px; left: 17px; right: 0;
      height: 1px; background: var(--line); }
    .timeline-step:last-child:before { display: none; }
    .dot { position: relative; width: 18px; height: 18px; border: 4px solid var(--accent-soft);
      border-radius: 50%; background: var(--accent); z-index: 1; }
    .tv { margin-top: 10px; font-weight: 750; font-size: 15px; }
    .step-label { color: var(--muted); font-size: 10px; }
    .action-split { color: var(--muted); font-size: 10px; margin-top: 7px; overflow-wrap: anywhere; }
    .action-split b { color: var(--ink); font-weight: 600; }
    .bars { display: grid; gap: 13px; margin-top: 12px; }
    .bar-row { display: grid; grid-template-columns: 100px 1fr 34px; align-items: center; gap: 9px; }
    .bar-label { color: var(--muted); font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .stack { display: flex; height: 10px; overflow: hidden; border-radius: 99px; background: var(--surface-2); }
    .stack span { min-width: 2px; } .stack .loop { background: #e29a50; }
    .stack .call_cap_hit { background: #bd4e4b; } .stack .malformed_tool_call { background: #9061c2; }
    .stack .gave_up { background: #b5813e; } .stack .false_success { background: #dd5968; }
    .stack .timeout { background: #6978c8; } .stack .other { background: #829087; }
    .bar-value { text-align: right; color: var(--muted); font-size: 10px; font-variant-numeric: tabular-nums; }
    .taxonomy-legend { display: flex; flex-wrap: wrap; gap: 9px 13px; margin-top: 15px; color: var(--muted); font-size: 9px; }
    .taxonomy-legend i { display: inline-block; width: 7px; height: 7px; border-radius: 50%;
      background: var(--legend-color); margin-right: 4px; }
    .fix-list { display: grid; gap: 10px; }
    .fix-item { padding: 15px; background: var(--surface); border: 1px solid var(--line);
      border-radius: 13px; }
    .fix-title { display: flex; align-items: center; gap: 8px; font-weight: 700; }
    .rank { color: var(--accent); font-size: 10px; }
    .fix-reason { color: var(--muted); font-size: 10px; margin: 4px 0 8px; }
    .fix-copy { border-left: 2px solid var(--accent); padding-left: 10px; color: var(--muted); font-size: 11px; }
    .method { padding: 15px 18px; color: var(--muted); font-size: 10px; }
    .method strong { color: var(--ink); }
    .foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 18px;
      color: var(--muted); font-size: 10px; }
    @media (max-width: 820px) {
      .hero { grid-template-columns: 1fr; } .hero-side { display: grid; grid-template-columns: 1fr 1fr; }
      .model-note { grid-column: 1 / -1; } .heatmap { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .lower-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 520px) {
      .shell { width: min(100% - 24px, 1180px); padding-top: 18px; }
      .run-id { display: none; } .hero-main { padding: 22px; }
      .heatmap { grid-template-columns: 1fr; } .hero-side { display: flex; }
      .bar-row { grid-template-columns: 82px 1fr 26px; } .foot { flex-direction: column; }
    }
    @media print {
      body { background: #fff; } .shell { width: 100%; padding: 0; }
      .panel, .heat-cell, .fix-item { box-shadow: none; break-inside: avoid; }
      button { display: none; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="brand"><span class="mark">S</span><div>SHAKEDOWN<small>Agent sensitivity lab</small></div></div>
      <div class="top-actions"><span class="run-id">{{ a.experiment_id }}</span>
        <button id="theme-toggle" type="button" aria-label="Toggle color theme">◐ Theme</button></div>
    </header>

    <section class="hero" aria-label="Experiment summary">
      <div class="panel hero-main">
        <div class="eyebrow">Reliability profile · {{ a.summary.tasks }} task{% if a.summary.tasks != 1 %}s{% endif %}</div>
        <h1>What does your agent depend on?</h1>
        <p class="lead">Controlled prompt and tool perturbations reveal where this agent is robust, fragile, or still uncertain.</p>
        <div class="baseline-row">
          <div class="baseline-value">{{ "%.0f"|format(a.baseline.rate * 100) }}%</div>
          <div class="baseline-meta"><strong>Baseline pass rate</strong>
            {{ a.baseline.k }} of {{ a.baseline.n }} runs · Wilson 95% CI
            {{ "%.0f"|format(a.baseline.wilson[0] * 100) }}–{{ "%.0f"|format(a.baseline.wilson[1] * 100) }}%<br>
            Unadjusted MDE at this sample size: {{ a.baseline.mde_at_n }} points
          </div>
        </div>
      </div>
      <aside class="panel hero-side" aria-label="Run metrics">
        <div class="mini-stat"><span>Total runs</span><strong>{{ a.summary.runs }}</strong></div>
        <div class="mini-stat"><span>Invalid runs</span><strong>{{ a.summary.invalid_runs }}</strong></div>
        <div class="mini-stat"><span>Tampered runs</span><strong>{{ a.summary.tampering_runs }}</strong></div>
        <div class="mini-stat"><span>Model calls</span><strong>{{ a.summary.calls }}</strong></div>
        <div class="mini-stat"><span>Tokens</span><strong>{{ "{:,}".format(a.summary.tokens) }}</strong></div>
        <div class="mini-stat"><span>Estimated spend</span><strong>${{ "%.4f"|format(a.summary.spend_usd) }}</strong></div>
        <div class="model-note">Model: {{ a.summary.model.name }} · success is the executable test exit code, never an LLM judge.</div>
      </aside>
    </section>

    <section aria-labelledby="heatmap-title">
      <div class="section-head">
        <div><h2 id="heatmap-title">Sensitivity heatmap</h2>
          <p>Success under each controlled perturbation. {{ a.summary.correction }}.</p></div>
        <div class="legend"><span class="lg-critical">Critical</span><span class="lg-clear">No meaningful effect</span>
          <span class="lg-open">Inconclusive</span></div>
      </div>
      <div class="heatmap">
        {% for c in a.cells %}
        <article class="heat-cell {{ c.verdict|replace(' ', '-') }}" data-kind="{{ c.kind }}">
          <div class="cell-top"><span class="kind">{{ c.kind }}</span><span class="verdict">{{ c.verdict }}</span></div>
          <div class="cell-title">{{ c.label }}</div>
          <div class="rate-line"><span>{{ c.k }}/{{ c.n }} passed</span><strong>{{ "%.0f"|format(c.rate * 100) }}%</strong></div>
          <div class="track" role="img" aria-label="{{ "%.0f"|format(c.rate * 100) }} percent passed">
            <div class="fill" style="width: {{ "%.1f"|format(c.rate * 100) }}%"></div></div>
          <div class="cell-metrics">
            <div><span>Δ pass rate</span><strong>{{ "%+.1f"|format(c.delta_points) }} pts</strong></div>
            <div><span>Raw p</span><strong>{{ "%.3f"|format(c.p_raw) }}</strong></div>
            <div><span>Adjusted p ({{ c.p_adjustment_family }})</span><strong>{{ "%.3f"|format(c.p_adjusted) }}</strong></div>
            <div><span>Family-adjusted MDE</span><strong>{{ c.mde_points }} pts</strong></div>
            <div><span>Exposure</span><strong>{% if c.exposure.exposure_rate is not none %}{{ "%.0f"|format(c.exposure.exposure_rate * 100) }}%{% else %}n/a{% endif %}</strong></div>
          </div>
          <p class="cell-note">{{ c.reason }} · within-family Δ CI {{ c.ci_points[0] }} to {{ c.ci_points[1] }} pts</p>
          <p class="cell-note">Label driven by {{ c.label_driven_by }} comparison:
            pooled Δ {% if c.comparison %}{{ "%+.1f"|format(c.comparison.delta * 100) }} pts,
            raw p={{ "%.3f"|format(c.p_raw_pooled) }}{% else %}n/a{% endif %};
            stratified {% if c.stratified_comparison %}
            Δ {{ "%+.1f"|format(c.stratified_comparison.delta * 100) }} pts,
            raw p={{ "%.3f"|format(c.stratified_comparison.p_value) }}
            across {{ c.per_task|length }} task strata{% else %}n/a{% endif %}.</p>
          {% if c.per_task %}
          <p class="cell-note">Per-task valid pass rates:
            {% for task_id, task in c.per_task.items() %}
            {{ task_id }} {{ "%.0f"|format(task.rate * 100) }}% ({{ task.k }}/{{ task.n }}){% if not loop.last %}; {% endif %}
            {% endfor %}</p>
          {% endif %}
          {% if c.exposure.comparison %}
          <p class="cell-note">Exposed runs: {{ c.exposure.k }}/{{ c.exposure.n }} passed
            · Δ {{ "%+.1f"|format(c.exposure.comparison.delta * 100) }} pts (descriptive)</p>
          {% endif %}
          <p class="cell-note">{{ c.claims.false_claims }} false claims / {{ c.n }} runs
            ({{ "%.0f"|format(c.claims.false_claim_rate * 100) }}%); {{ c.taxonomy.failed }} failures classified</p>
        </article>
        {% else %}
        <div class="panel empty">No perturbation cells in this run. Run the full grid to build a sensitivity map.</div>
        {% endfor %}
      </div>
    </section>

    <section class="lower-grid">
      <article class="panel content-card">
        <div class="section-head"><div><h2>First divergence</h2>
          <p>Exploratory comparison of normalized tool calls; not a confirmatory result.</p></div></div>
        {% if a.divergence.headline and a.divergence.headline.timeline %}
        <div class="timeline">
          {% for p in a.divergence.headline.timeline %}
          <div class="timeline-step">
            <div class="dot" title="Total variation distance {{ p.tv }}"></div>
            <div class="tv">{{ "%.2f"|format(p.tv) }}</div><div class="step-label">Step {{ p.step + 1 }} · TV distance</div>
            <div class="action-split"><b>Pass</b> {{ p.pass_top }}<br><b>Fail</b> {{ p.fail_top }}</div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <div class="empty">Not enough passing and failing traces to compare action paths.</div>
        {% endif %}
        {% if a.divergence.headline and a.divergence.headline.exploratory_permutation_p is not none %}
        <p class="cell-note">Exploratory within-task permutation test of maximum TV across eligible steps:
          p={{ "%.4f"|format(a.divergence.headline.exploratory_permutation_p) }}.</p>
        {% endif %}
      </article>

      <article class="panel content-card">
        <div class="section-head"><div><h2>Failure taxonomy</h2>
          <p>Rule-based causes among failed runs · no model judge.</p></div></div>
        {% for c in a.cells %}
        {% if c.taxonomy.failed %}
        <div class="bars">
          <div class="bar-row"><span class="bar-label" title="{{ c.label }}">{{ c.label }}</span>
            <div class="stack" role="img" aria-label="{{ c.taxonomy.failed }} classified failures">
              {% for category, count in c.taxonomy.counts.items() if count %}
              <span class="{{ category|replace('-', '_') }}" style="width: {{ (100 * count / c.taxonomy.failed)|round(1) }}%"
                title="{{ category }}: {{ count }}"></span>
              {% endfor %}
            </div><span class="bar-value">{{ c.taxonomy.failed }}</span>
          </div>
        </div>
        {% endif %}
        {% else %}
        <div class="empty">Failure categories appear after perturbation runs.</div>
        {% endfor %}
        <div class="taxonomy-legend">
          <span><i style="--legend-color:#e29a50"></i>Loop</span><span><i style="--legend-color:#bd4e4b"></i>Call cap</span>
          <span><i style="--legend-color:#9061c2"></i>Malformed call</span><span><i style="--legend-color:#b5813e"></i>Gave up</span>
          <span><i style="--legend-color:#dd5968"></i>False success</span><span><i style="--legend-color:#6978c8"></i>Timeout</span>
          <span><i style="--legend-color:#829087"></i>Other</span>
        </div>
      </article>
    </section>

    <section aria-labelledby="fix-title">
      <div class="section-head"><div><h2 id="fix-title">Fix first</h2>
        <p>Ranked only from supported signals; suggested wording is ready to test.</p></div></div>
      <div class="fix-list">
        {% for f in a.fix_first %}
        <article class="fix-item">
          <div class="fix-title"><span class="rank">0{{ loop.index }}</span>{{ f.label }}
            <span class="pill">{{ f.verdict }}</span></div>
          <div class="fix-reason">{{ f.reasons|join(" · ") }} · adjusted p={{ "%.3f"|format(f.p_adjusted) }}</div>
          <div class="fix-copy">{{ f.suggestion.text }}</div>
        </article>
        {% else %}
        <div class="panel empty">No statistically supported fix-first candidate yet. Keep sampling ambiguous cells.</div>
        {% endfor %}
      </div>
    </section>

    <section class="panel method">
      <strong>Method</strong> · {{ a.methods.interval }} · {{ a.methods.test }} · {{ a.methods.difference_ci }}.
      {{ a.methods.correction }}:
      {% for family, size in a.methods.family_sizes.items() %}
      {{ family }} ({{ size }} cells, {{ (a.methods.per_look_confidence_by_family[family] * 100)|round(2) }}% per-look CI confidence){% if not loop.last %}; {% endif %}
      {% endfor %}.
      “Inconclusive” means the interval still includes a meaningful effect (±{{ (a.methods.meaningful_drop * 100)|round|int }} points);
      it does not mean “no effect.” Cell MDE assumes 80% power at within-family, sequentially spent α; baseline MDE is unadjusted.
    </section>
    <footer class="foot"><span>Shakedown · Sensitivity, not certainty.</span>
      <span>Generated {{ a.generated_at }} · {{ a.summary.elapsed_minutes }} min elapsed</span></footer>
  </main>
  <script>
    window.SHAKEDOWN = {{ a|tojson }};
    document.getElementById("theme-toggle").addEventListener("click", function () {
      const root = document.documentElement;
      root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
    });
  </script>
</body>
</html>
